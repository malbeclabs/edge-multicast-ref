# Copy to .env and edit for your environment.
# .env is gitignored so you can hold real values here.

# ─── Feed ──────────────────────────────────────────────────────────
# Multicast group the parser joins.
# For a real DZ Edge feed, set this to the group your DZD subscribes to.
# For isolated local testing, any admin-scope address works.
DZ_MULTICAST_GROUP=239.10.10.10

# Ports on the multicast group (marketdata and refdata channels).
DZ_MARKETDATA_PORT=7001
DZ_REFDATA_PORT=7002

# Network interface to join multicast on. On a DZ-connected host this is
# typically the GRE tunnel interface (e.g. doublezero1).
DZ_INTERFACE=doublezero1

# ─── Bot filter ────────────────────────────────────────────────────
# Comma-separated symbols the bot persists to ClickHouse. Empty = all.
# Keep small for Prometheus cardinality on a high-symbol-count venue.
DZ_SYMBOLS=

# ─── Dashboard ─────────────────────────────────────────────────────
# Grafana admin password (user is `admin`). Change before exposing.
GF_ADMIN_PASSWORD=admin

# ─── Ports exposed on the host ─────────────────────────────────────
# Defaults bind to 127.0.0.1 only (see docker-compose.yml). Override if
# you want to reach them from another host without SSH tunneling.
GRAFANA_HOST_PORT=3000
CLICKHOUSE_HTTP_PORT=8123
BOT_METRICS_PORT=9091
PARSER_METRICS_PORT=9090

# ─── Depth-of-book feed ────────────────────────────────────────────
# Multicast group for depth-of-book feed.
DZ_DOB_MULTICAST_GROUP=239.10.10.20

# Ports on the multicast group (refdata, marketdata, and snapshot channels).
DZ_DOB_REFDATA_PORT=7011
DZ_DOB_MKTDATA_PORT=7012
DZ_DOB_SNAPSHOT_PORT=7013

# Comma-separated symbols the bot persists to ClickHouse. Empty = all.
DZ_DOB_SYMBOLS=

# Book depth to maintain (number of price levels).
DZ_DOB_DEPTH=20

# Coalesce interval in milliseconds.
DZ_DOB_COALESCE_MS=50

# Depth-of-book bot metrics port exposed on the host.
DOB_BOT_METRICS_PORT=9092
