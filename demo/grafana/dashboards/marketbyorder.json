        "includeAllFields": true,
        "mode": "candles"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "clickhouse-topofbook",
            "type": "grafana-clickhouse-datasource"
          },
          "queryType": "sql",
          "rawSql": "WITH\n  best AS (\n    SELECT\n      recv_ts,\n      maxIf(price, side = 'bid' AND level_idx = 0) AS bid,\n      minIf(price, side = 'ask' AND level_idx = 0) AS ask\n    FROM marketbyorder.level_snapshots\n    WHERE symbol = ${symbol:singlequote} AND $__timeFilter(recv_ts)\n    GROUP BY recv_ts\n    HAVING bid > 0 AND ask > 0\n  ),\n  q AS (\n    SELECT\n      toStartOfInterval(recv_ts, INTERVAL ${candle_interval:raw} SECOND) AS time,\n      argMin((bid + ask) / 2, recv_ts) AS open,\n      max((bid + ask) / 2) AS high,\n      min((bid + ask) / 2) AS low,\n      argMax((bid + ask) / 2, recv_ts) AS close\n    FROM best\n    GROUP BY time\n  ),\n  v AS (\n    SELECT\n      toStartOfInterval(recv_ts, INTERVAL ${candle_interval:raw} SECOND) AS time,\n      sum(ifNull(qty, 0)) AS volume\n    FROM marketbyorder.events\n    WHERE kind IN ('trade', 'order_execute') AND symbol = ${symbol:singlequote} AND $__timeFilter(recv_ts)\n    GROUP BY time\n  )\nSELECT q.time, q.open, q.high, q.low, q.close, ifNull(v.volume, 0) AS volume\nFROM q\nLEFT JOIN v USING time\nORDER BY q.time",
          "format": 1
        },
        {
          "refId": "B",
          "datasource": {
            "uid": "clickhouse-topofbook",
            "type": "grafana-clickhouse-datasource"
          },
          "queryType": "sql",
          "rawSql": "SELECT recv_ts AS time, price AS trade\nFROM marketbyorder.events\nWHERE '${show_trades:raw}' = 'yes'\n  AND kind IN ('trade', 'order_execute')\n  AND symbol = ${symbol:singlequote}\n  AND $__timeFilter(recv_ts)\n  AND price IS NOT NULL\nORDER BY time",
          "format": 0
        }
      ]
    },
