      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "clickhouse-topofbook",
            "type": "grafana-clickhouse-datasource"
          },
          "queryType": "sql",
          "rawSql": "WITH\n  q AS (\n    SELECT\n      toStartOfInterval(recv_ts, INTERVAL ${candle_interval:raw} SECOND) AS time,\n      argMin(mid, recv_ts) AS open,\n      max(mid) AS high,\n      min(mid) AS low,\n      argMax(mid, recv_ts) AS close\n    FROM topofbook.quotes\n    WHERE symbol IN (${symbols:singlequote}) AND $__timeFilter(recv_ts)\n    GROUP BY time\n  ),\n  v AS (\n    SELECT\n      toStartOfInterval(recv_ts, INTERVAL ${candle_interval:raw} SECOND) AS time,\n      sum(qty) AS volume\n    FROM topofbook.trades\n    WHERE symbol IN (${symbols:singlequote}) AND $__timeFilter(recv_ts)\n    GROUP BY time\n  )\nSELECT\n  q.time,\n  q.open,\n  q.high,\n  q.low,\n  q.close,\n  ifNull(v.volume, 0) AS volume\nFROM q\nLEFT JOIN v USING time\nORDER BY q.time",
          "format": 1
        },
