          "refId": "B",
          "datasource": {
            "uid": "clickhouse-topofbook",
            "type": "grafana-clickhouse-datasource"
          },
          "queryType": "sql",
          "rawSql": "SELECT\n  recv_ts AS time,\n  price AS trade\nFROM topofbook.trades\nWHERE '${show_trades:raw}' = 'yes'\n  AND symbol IN (${symbols:singlequote})\n  AND $__timeFilter(recv_ts)\nORDER BY recv_ts",
          "format": 0
        }
