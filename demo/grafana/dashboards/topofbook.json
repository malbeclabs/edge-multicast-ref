          "rawSql": "SELECT\n  symbol,\n  max(recv_ts) AS last_update,\n  dateDiff('millisecond', max(recv_ts), now64(3)) / 1000 AS age_seconds\nFROM topofbook.quotes\nWHERE symbol IN (${symbols:singlequote}) AND $__timeFilter(recv_ts)\nGROUP BY symbol\nORDER BY age_seconds DESC\nLIMIT 20",
